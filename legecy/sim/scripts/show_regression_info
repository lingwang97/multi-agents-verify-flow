import os
import sys
import re
vld_regresion_dir_pattern="uvm_scratch_[a-z]+[0-9]*(_[a-z]+){0,2}_[0-9]+_"

def logdir2module(regression_dir):

    #vld_regresion_dir_pattern="uvm_scratch_[a-z]+[0-9]*(_[a-z]+)?_[0-9]+"
    module_list=["cpft_fpga","cpft","cpm","dfx","efuse","fpga","ft","self_top","io","jls",\
                "mc","mx2_block","mx2","mx2_block_negative","pvt","reg","ro","rst","selfclk","selfclk_stage",
                "spd_smp","spd_ada","spd_gbp","spd_lfb","uart","uart_vip","work","jamlink","top","type"]

    result=re.match(vld_regresion_dir_pattern,regression_dir)
    if(result !=None):
        tmp=result.group()
        
        item=tmp.split("_")
        #print("regression_dir_pattern:",tmp,"len:",len(item))
        if(len(item)>4 and len(item)<8):

            if(len(item)==5):
                vld_item=item[2]
                if(vld_item in module_list):
                    return " "+vld_item+"\t\t\t",True
                else:
                    return None,False

            elif(len(item)==6):
                vld_item=item[2]+"_"+item[3]
                if(vld_item in module_list):
                    return " "+vld_item+"\t\t" ,True
                else:
                    return None,False
            elif(len(item)==7):
                vld_item=item[2]+"_"+item[3]+"_"+item[4]
                if(vld_item in module_list):
                    return " "+vld_item+"\t",True
                else:                 
                    return None,False
            else:               
                return None,False
  
        else:
            return None,False
    else:
        print("Error:[case 0]parse uvm regeresson dir failed")
        return None,False

def list2num(list_name):
    test_num=0
    test_num_with_it=0
    iter_pattern="iter=[0-9]+"
    with  open(list_name) as f:
        res_lines=f.readlines()
        for line in res_lines:
            #print("test_line:",line)
            if (line.startswith("testname=")):
                test_num=test_num+1
                result=re.search(iter_pattern,line)
                iter_times=eval(result.group().split("=")[1])
                if(iter_times>0):
                    test_num_with_it=test_num_with_it+iter_times
                else:
                    print("ERROR:Parse list file failed")
                    exit()
    #print("iter_times:",iter_times,"test_num_with_it:",test_num_with_it)
    return test_num,test_num_with_it

if(len(sys.argv)==1):
    current =os.getcwd()
    dir_list= os.listdir(current)
    all_check=False
else:
    vld_dir_list=[]
    if(os.path.isdir(sys.argv[1]) and sys.argv[1].startswith("uvm_scratch_")):
        print("%"*20,"searching:",sys.argv[1],"%"*20)
        current=sys.argv[1]
        vld_dir_list.append(current)
        all_check=True
    elif(sys.argv[1]=="all"):
        print("%"*20,"searching all regression info in all module:","%"*20)
        all_check=True
        all_dir_list= os.listdir(os.getcwd())
        #print("all:",all_dir_list)

        #vld_regresion_dir_pattern="uvm_scratch_[a-z]+[0-9]*_[0-9]+"
        #vld_regresion_dir_pattern="uvm_scratch_[a-z]+[0-9]*(_[a-z]+){0,2}_[0-9]+"
        for dir_vld in all_dir_list:
            
            if(re.match(vld_regresion_dir_pattern,dir_vld)!=None):
                if(logdir2module(dir_vld)[1]):
                    vld_dir_list.append(dir_vld)
                    #print("add:",dir_vld)
                
        #print("\033[1;31mvld_dir_list:",vld_dir_list,"\033[0m")

    else:
        print("%"*20,"load dir argv error,check whether input argv is right","%"*20)
        exit()


tatal=0
tatal_pass=0
tatal_fail=0
tatol_err=0
tatal_running=0
exp_total_test_num=0
exp_total_test_num_with_it=0
details=[]

if (all_check==False):
    all_seq=[]
    for i in dir_list:
        if(i.startswith('FAKECORE_sim_') or i .startswith("REALCORE_sim_")):
            all_seq.append(i)

    if(all_seq==[]):
        raise Exception("all_seq is none,failed to get sequence, please check and try again")

    if(os.path.isfile(os.path.join(current,'result.txt'))):
        with  open(os.path.join(current,'result.txt')) as f:
            res_lines=f.readlines()
            f.close()
    else:
        raise Exception("please make sure you are in Regression Result Directory")
        
    rest_seq=[]
    for line in res_lines:
        fake_vld_line='FAKECORE_sim_'+line.split()[0]+'_RTL'
        real_vld_line='REALCORE_sim_'+line.split()[0]+'_RTL'
        if( fake_vld_line in all_seq):
            all_seq.remove(fake_vld_line)
        if( real_vld_line in all_seq):
            all_seq.remove(real_vld_line)

    rest_seq=all_seq

    if(rest_seq!=[]):
        print("\033[1;31m Still rest "+ str(len(rest_seq)) +" seqs:\033[0m")
        for i in rest_seq:
            print(i)
    else:
        print("*"*20,"\033[1;36mWow! ALL seqs have done! let's sing together\033[0m","*"*20)
else:
    #if has many repeat dir,will generate wrong number //FIX ME
    for vld_dir in vld_dir_list:

        sub_total=0
        sub_pass=0
        sub_fail=0
        sub_err=0
        sub_running=0
        exp_test_num=0
        exp_test_num_with_it=0
        dir_list= os.listdir(vld_dir)
        all_seq=[]
        for i in dir_list:
            if(i.startswith('FAKECORE_sim_') or i .startswith("REALCORE_sim_")):
                all_seq.append(i)
            elif(i.endswith("test.list")):
                exp_test_num,exp_test_num_with_it=list2num(os.path.join(vld_dir,i))
        #print("exp_test_num:",exp_test_num,"exp_test_num_with_it",exp_test_num_with_it)
        sub_total=len(all_seq)
        
        if(os.path.isfile(os.path.join(vld_dir,'result.txt'))):
            with  open(os.path.join(vld_dir,'result.txt')) as f:
                res_lines=f.readlines()
                f.close()
            
            rest_seq=[]
            fail_seq=[]
            for line in res_lines:
                add_fali=False
                if(line.split()[1]=="PASS"):
                    sub_pass+=1
                elif(line.split()[1]=="FAIL"):
                    sub_fail+=1
                    add_fali=True
                elif(line.split()[1]=="compile_error"):
                    sub_err +=1
                    add_fali=True
                    #print("sub_err:",sub_err)

                fake_vld_line='FAKECORE_sim_'+line.split()[0]+'_RTL'
                real_vld_line='REALCORE_sim_'+line.split()[0]+'_RTL'
                if( fake_vld_line in all_seq):
                    all_seq.remove(fake_vld_line)
                    if(add_fali):
                        fail_seq.append(line.split()[0]+"\t\tsim dir:"+vld_dir+"/"+fake_vld_line)
                if( real_vld_line in all_seq):
                    all_seq.remove(real_vld_line)
                    if(add_fali):
                        fail_seq.append(line.split()[0]+"\t\tsim dir:"+vld_dir+"/"+real_vld_line)
                        #fail_seq.append(real_vld_line)

            rest_seq=all_seq
            sub_running=len(rest_seq)
            if(rest_seq!=[]):
                
                tmp=logdir2module(vld_dir)[0]+"Seq:"+str(exp_test_num)+"   "+"\tTotal:"+str(exp_test_num_with_it)+" "+"\tSubmitted:"+str(sub_total)+"/"+str(exp_test_num_with_it)+"   "+'\tpassed:'+\
                    str(sub_pass)+"\tfailed:"+str(sub_fail)+"\tcompile_err:"+str(sub_err)+"    "+"\trunning:"+str(sub_running)+"\tpass_rate:"+\
                    str(round(sub_pass/(exp_test_num_with_it+0.001),3))+"\t"+logdir2module(vld_dir)[0]
                 
                print("\033[1;34m",vld_dir+":sub_tatal:",sub_total," passed:",sub_pass," failed:",sub_fail," compile_err:",sub_err," running:",sub_running,"pass_rate:",str(round(sub_pass/(sub_total+0.0001),3)*100),"%\033[0m")
                if(fail_seq!=[]):
                    print("\033[1;34m","The following is failed "+ str(len(fail_seq)) +" seqs:\033[0m")
                    for i in fail_seq:
                        print(i)
                    tmp="\033[1;31m"+logdir2module(vld_dir)[0]+"\033[0mSeq:"+str(exp_test_num)+"   "+"\tTotal:"+str(exp_test_num_with_it)+" "+"\tSubmitted:"+str(sub_total)+"/"+str(exp_test_num_with_it)+"   "+'\tpassed:'+\
                        str(sub_pass)+"\033[1;31m\tfailed:"+str(sub_fail)+"\tcompile_err:"+str(sub_err)+"    "+"\033[0m\trunning:"+str(sub_running)+"\tpass_rate:"+\
                        str(round(sub_pass/(exp_test_num_with_it+0.001),3))+"\t\033[1;31m"+logdir2module(vld_dir)[0]+"\033[0m"
                                            
                print("\033[1;34m","The following is the running "+ str(len(rest_seq)) +" seqs:\033[0m")
                for i in rest_seq:
                    print(i)
                details.append(tmp)  
            else:
                tmp=logdir2module(vld_dir)[0]+"Seq:"+str(exp_test_num)+"   "+"\tTotal:"+str(exp_test_num_with_it)+" "+"\tSubmitted:"+str(sub_total)+"/"+str(exp_test_num_with_it)+"   "+'\tpassed:'+\
                    str(sub_pass)+"\tfailed:"+str(sub_fail)+"\tcompile_err:"+str(sub_err)+"    "+"\trunning:"+str(sub_running)+"\tpass_rate:"+\
                    str(round(sub_pass/(exp_test_num_with_it+0.001),3))+"\t"+logdir2module(vld_dir)[0]
                
                print("\033[1;34m",vld_dir+":sub_tatal:",sub_total," passed:",sub_pass," failed:",sub_fail," compile_err:",sub_err," running:",sub_running,"pass_rate:",str(round(sub_pass/(sub_total+0.0001),3)*100),"%\033[0m")
                if(fail_seq!=[]):
                    print("\033[1;34m","The following is failed "+ str(len(fail_seq)) +" seqs:\033[0m")
                    for i in fail_seq:
                        print(i)
                    tmp="\033[1;31m"+logdir2module(vld_dir)[0]+"\033[0mSeq:"+str(exp_test_num)+"   "+"\tTotal:"+str(exp_test_num_with_it)+" "+"\tSubmitted:"+str(sub_total)+"/"+str(exp_test_num_with_it)+"   "+'\tpassed:'+\
                        str(sub_pass)+"\033[1;31m\tfailed:"+str(sub_fail)+"\tcompile_err:"+str(sub_err)+"    "+"\033[0m\trunning:"+str(sub_running)+"\tpass_rate:"+\
                        str(round(sub_pass/(exp_test_num_with_it+0.001),3))+"\t\033[1;31m"+logdir2module(vld_dir)[0]+"\033[0m"
                elif(exp_test_num_with_it==sub_pass):
                    tmp="\033[01;32m"+logdir2module(vld_dir)[0]+"Seq:"+str(exp_test_num)+"   "+"\tTotal:"+str(exp_test_num_with_it)+" "+"\tSubmitted:"+str(sub_total)+"/"+str(exp_test_num_with_it)+"   "+'\tpassed:'+\
                        str(sub_pass)+"\tfailed:"+str(sub_fail)+"\tcompile_err:"+str(sub_err)+"    "+"\trunning:"+str(sub_running)+"\tpass_rate:"+\
                        str(round(sub_pass/(exp_test_num_with_it+0.001),3))+"\t"+logdir2module(vld_dir)[0]+"\033[0m"


                details.append(tmp)
        tatal+=sub_total
        tatal_fail+=sub_fail
        tatal_pass+=sub_pass
        tatal_running+=sub_running
        tatol_err+=sub_err
        exp_total_test_num+=exp_test_num
        exp_total_test_num_with_it+=exp_test_num_with_it
    if(sys.argv[1]=="all"):
        tmp="Overall\t\t"+"Seq:"+str(exp_total_test_num)+"   "+"\tTotal:"+str(exp_total_test_num_with_it)+"\tSubmitted:"+str(tatal)+"/"+str(exp_total_test_num_with_it)+"   "+'\tPassed:'\
            +str(tatal_pass)+"\tFailed:"+str(tatal_fail)+"\tCompile Error:"+str(tatol_err)+"    "+"\tRunning:"+\
            str(tatal_running)+"\tPass_rate:"+str(round(tatal_pass/(exp_total_test_num_with_it+0.001),3))+"\t Overall"
        length=(len(tmp)+36)
        half=int(length/2)-11
        print("\033[1;31m","="*(len(tmp)+36),"\033[0m") 
        print("\033[1;31m","="*half,"[Regression Summary]","="*half,"\033[0m")  
        print("\033[1;31m","="*(len(tmp)+36),"\033[0m") 
       #print("details",details)  
        for module_detail in sorted(details):
            print(module_detail)  
            
        if(exp_total_test_num_with_it==tatal_pass):
            print("\033[1;32m",tmp,"\033[0m") 
        else:
            print("\033[1;31m",tmp,"\033[0m")  
        print("\033[1;31m","="*(len(tmp)+36),"\033[0m")  
        print("\033[1;31m","="*(len(tmp)+36),"\033[0m") 
        print("\033[1;31m","="*(len(tmp)+36),"\033[0m")
        print(" Note: If you find any display errors or unsupported modules, please let wangling know, thanks")


             