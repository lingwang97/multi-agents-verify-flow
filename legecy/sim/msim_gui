class DataDisplayWidget(QWidget):
    dataChanged = pyqtSignal(dict)
    path_select = pyqtSignal(str)
    def __init__(self):
        super().__init__()

        self.layout = QFormLayout()
        self.setLayout(self.layout)

        self.line_edits = {}
        self.save_button = QPushButton("保存")
        self.save_button.clicked.connect(self.save_clicked)
    def display_data(self, data):
        self.clear_layout()

        for key, value in data.items():
  
            key_label = QLabel(key)
            value_line_edit = QLineEdit(value)
            self.line_edits[key] = value_line_edit
            self.layout.addRow(key_label, value_line_edit)
        button_layout = QHBoxLayout()
        button_layout.addWidget(self.save_button)

        self.layout.addRow(button_layout)

    def clear_layout(self):
        while self.layout.count():
            item = self.layout.takeAt(0)
            widget = item.widget()
            if widget:
                widget.deleteLater()


    def save_clicked(self):
        data = {}
        for key, value in self.line_edits.items():

            if isinstance(value, list):
                for radio_button in value:
                    if radio_button.isChecked():
                        data[key] = radio_button.text()
                        break
            else:

                data[key] = value.text()
        self.dataChanged.emit(data)

    def simulate_clicked(self):
        # Add your simulate action here
        print("Simulate clicked")


