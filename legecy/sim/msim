        bsub_option="bsub -n ${OPTS_LSF_CORES} -m ${OPTS_HOST} -I ${OPTS_LSF_SIG} -q ${OPTS_LSF_QUEUE}"
    elif [[ $OPTS_LSF == "TRUE" ]]; then
        ## This part need to be maintained
        host_file="/lsf/conf/lsbatch/kulh1-clu-lsf01/configdir/lsb.hosts"
        lines=$(grep "n4amd83" ${host_file})
        queue_names=($(grep "n4amd83" ${host_file} | head -3 | cut -d ' ' -f 1))
        lsf_queue_name=($(grep "n4amd83" ${host_file} | head -3 | cut -d ' ' -f 1 | sed 's/amd/a/g'))
        queue_number=${#queue_names[@]}
        lsf_host_name=(0 0 0)
        lsf_host_slot=(0 0 0)
        #declare -A lsf_host_name
        for((i=0;i<queue_number;i+=1));do
            queue=${queue_names[i]}
            echo -e "\tThe queue is : ${queue}"
            temp=$(grep $queue ${host_file} | grep -Eo "kulh1-a[0-9a-zA-Z]+-cch[0-9]+")
            temp1=($temp)
            tmp_line=""
            for tmp in "${temp1[@]}";do
                tmp_line+=$tmp" "
            done
            lsf_host_name[i]=$tmp_line
            #echo -e "\tThe lsf_host is : \n\t\t\t${lsf_host_name[i]}"
        done

        t1=$(bhosts -o "HOST_NAME")
        hosts=($t1)
        t2=$(bhosts -o "status")
        host_status=($t2)
        t3=$(bhosts -o "MAX")
        host_max=($t3)
        t4=$(bhosts -o "NJOBS")
        host_njobs=($t4)

        for((i=0;i<queue_number;i+=1));do
            tmp=${lsf_host_name[i]}
            queue=($tmp)
            #echo queue $queue
            for host in "${queue[@]}";do
            #echo host $host
            index=0
            for reg in "${hosts[@]}"; do
                #echo reg $reg
                if [[ "${host}" == *"${reg}"* ]];then
                #echo $index
                break
                fi
                index=$(($index+1))
            done
            if [[ ${host_status[index]} == "ok" ]]; then
                lsf_host_slot[i]=$((${lsf_host_slot[i]}+${host_max[index]}-${host_njobs[index]}))
            fi
            done
        done

        for((i=0;i<queue_number;i+=1));do
            echo -e "\tThe ${lsf_queue_name[i]} has ${lsf_host_slot[i]} remaining"
            echo -------------------------------------------------------
        done

        max=0
        max_index=0
        for((i=0;i<queue_number;i++));do
            if [[ $max -lt ${lsf_host_slot[i]} ]];then
                max=${lsf_host_slot[i]}
                max_index=$i
            fi
        done

        OPTS_LSF_QUEUE=${lsf_queue_name[max_index]}

        if [[ $OPTS_QUEUE == "TRUE" ]] ; then
            bsub_option="bsub -n $OPTS_LSF_CORES -I -R \"order[ut]\" -q  ${OPTS_SET_QUEUE} ${OPTS_LSFSIG} "
        else
            bsub_option="bsub -n $OPTS_LSF_CORES -I -R \"order[ut]\" -q  ${OPTS_LSF_QUEUE} ${OPTS_LSFSIG} "
        fi

	bsub_option+="-J \"run_in$(pwd)\" "
    fi # end of elif [[ $OPTS_LSF == "TRUE" ]]; then
    make_para="$make_define $make_option"

    #gen_cfg_files $current_case
    #run_sys
    #In order to be compatible with the previous pure sv env, makefile decided to be still in use
    if [ "$OPTS_GEN_MODE_SWITCH" == "FALSE" ] ; then
 	log 2 "running command: ${bsub_option} ${timeout_option} ${make_para} at `pwd`"
	${bsub_option} ${timeout_option} ${make_para}
	if [[ -f sim.log ]]; then
	    status=$?
       if [[ $status -eq 0 ]]; then
         echo "simulation status exit code: $status" | tee -a sim.log
       fi
       if [[ $OPTS_TRY_ALL_HOST -ge 0 ]]; then
         if [[ $(grep "FGP_AFFINITY_FAILED" sim.log) ]]; then
           rm subloop.log -f
           echo "FGP_AFFINITY_FAILED found, OPTS_TRY_ALL_HOST is $OPTS_TRY_ALL_HOST" | tee -a subloop.log
           #queue_number=4
           echo ${bsub_option} ${timeout_option} ${make_para} > sim_rerun
           chmod +x sim_rerun
           sed -i 's/bsub.*make/bsub -n 40 -m $1 -I -q $2 -J $3 make covsim/' sim_rerun
           closed_host=$(bhosts | grep "closed")
           submited=0
           #while [ 1 ]
           for((idx=1;idx<=$OPTS_TRY_ALL_HOST;idx+=1));do
             echo "+++++++++++++ try all $queue_number queue and host, $idx loop" | tee -a subloop.log
             for((q=0;q<queue_number;q+=1));do
               qn=${lsf_queue_name[q]}
               tmp=${lsf_host_name[q]}
               queue=($tmp)
               for host in "${queue[@]}";do
                 host=${host//\"}
                 myjobid=$(date +%N)
                 echo "+++++++++++++ try host: $qn ${host}" | tee -a subloop.log
                 if [[ $closed_host =~ $host ]]; then
                   echo "+++++++++++++       $qn ${host} closed,skip it." | tee -a subloop.log
                   echo "step_0: $qn $host closed, Skip it." | tee -a subloop.log
                   continue
                 fi
                 sim_rerun ${host} $qn JID_$myjobid"_"$(pwd) &
                 usleep 10000000 # wait 10s
                 jobid=$(bjobs -w | grep JID_$myjobid | head -c 8 )
                 echo "step_1: $jobid, Begin__$qn $host " | tee -a subloop.log
                 pcnt=0
                 while [ 1 ]
                 do
                   usleep 30000000 # wait 30s
                   pcnt=$(($pcnt+1))
                   flag=$(bjobs -w | grep JID_$myjobid | grep RUN )
                   pflag=$(bjobs -w | grep JID_$myjobid | grep PEND)
                   if [[ $flag ]]; then
                     echo "step_2: $jobid,   Submit Done!" | tee -a subloop.log
                     submited=1
                     break
                   fi
                   if [[ $pflag ]]; then
                     echo "step_3: $jobid,   Waitting PEND $pcnt times." | tee -a subloop.log
                     if [[ $pcnt -eq 2 ]]; then
                        echo "step_4: $jobid,   Waitting PEND timeout, killed." | tee -a subloop.log
                        bkill $jobid
                        break
                     fi
                   else
                     echo "step_5: $jobid,   Submit Fail!" | tee -a subloop.log
                     break
                   fi
                 done
                 echo "step_6: $jobid, End____$qn $host" | tee -a subloop.log
                 if [[ $submited -eq 1 ]]; then
                   echo "step_7: Job submitted, Skip other host" | tee -a subloop.log
                   break
                 fi
               done
               if [[ $submited -eq 1 ]]; then
                 echo "step_7: Job submitted, Skip other queue" | tee -a subloop.log
                 break
               fi
             done
             if [[ $submited -eq 1 ]]; then
               break
             else
               echo "step_8: Had try all queue and host" | tee -a subloop.log
             fi
           done # end of idx
         fi
       fi # end of OPTS_TRY_ALL_HOST

	  fi
   fi
    rm -rf csrc
    if [[ -f cm.log ]]; then
        rm cm.log
    fi
    if [ $OPTS_DUMPFSDB == "FALSE" ] ; then
        rm -rf simv.daidir/*.so
	rm simv
    fi

    if [[ ! -f sim.log ]]; then
        log 1 " sim.log is not generated, please check make command is working or not"
        echo "$folder			compile_error" >> ${sim_dir}/result.txt
	cd $dir_path
	break
    fi

    print_result $folder $testname  | tee -a sim.log | tee -a $simlog_dir
    #go back to dir
    cd $dir_path
    break
}


###
 # Basic parse function for register list file.
 ##
function parse_list()
{
    local opts
    local opts_cnt
    local line_cnt
    local line
    local i
    local current_case
    local print_case
    local case_cnt
    local line_opt
    local line_opt_cnt

    i=0
    line_cnt=0
    case_cnt=0

	## make the regression has the highest priority, then module tests and then single test has the lowest priority
        ## current path shall at sim/${project}
        if [[ -n $OPTS_TESTCASE_NAME ]]; then
	    python_opt="-c $OPTS_TESTCASE_NAME"
	    outputfile="${sim_dir}${OPTS_TESTCASE_NAME}.list"
	    folderNamePre=""
	    fi

        if [[ -n $OPTS_MODULE ]]; then
	    python_opt="-m $OPTS_MODULE"
	    outputfile="${sim_dir}${OPTS_MODULE}_test.list"
	    folderNamePre=$OPTS_MODULE
        fi

        if [[ -n $OPTS_REGRESSION_MODE ]]; then
            python_opt="--"$OPTS_REGRESSION_MODE
	    outputfile="${sim_dir}${OPTS_REGRESSION_MODE}_test.list"
	    folderNamePre=$OPTS_REGRESSION_MODE
	fi

	if [[ -z $outputfile ]]; then
	    log 1 " There is no valid testcase/group put in the command option."
	    exit
	fi

	if [[ $OPTS_REAL_CORE == "TRUE" ]]; then
	    realCore_opt="--real"
	fi

	if [[ -n $OPTS_LEVEL ]]; then
	    level_opt="-l ${OPTS_LEVEL}"
	fi

	projectfile_name=$dir_path/project_name

    	project=`cat $projectfile_name`

	python_command="python3.6 $database_path/verify/uvm/test/testjson2lst.py -f $database_path/verify/uvm/test/test.json --define $database_path/hdl/common/top/chip_define.sv $python_opt $realCore_opt -o $outputfile ${level_opt} --project ${project}"
	log 3 "running command: $python_command"
	$python_command | tee -a $simlog_dir

	status=$?
	if [[ $status -eq 0 ]]; then
	    log 2 "parsing test.json successfully"
	else
	    log 1 " ($me) There are errors raised in parsing test.json file, please check the command option. Check the usage of verify/uvm/test/testjson2lst.py usage with -h/--help"
	    exit
	fi

	log 3 "start to build uvm cases"
        ##here parse the test.list specific for UVM simulation environment
        index=0
	casecnt=0
    touch ./result.txt
    touch ./fail_wave.txt
	while read line
	do
	    ## remove comment part
	    #line=${line%%[//]*}

	    line_opt=($line)
            line_opt_cnt=${#line_opt[*]}
	    make_option=""
	    if [[ "$line_opt_cnt" -ge "2" ]]; then
		index=$(($index+1))
		test=${line_opt[0]##testname=}
		testname=${line_opt[0]##testname=}"_"$folderNamePre
		iteration=${line_opt[1]##iter=}
		if [[ -n "$OPTS_SEED_VALUE" ]]; then
		    iteration=1
		fi
		if [[ -n "$OPTS_ITERTION" ]]; then
		    iteration=${OPTS_ITERTION}
		fi
		casecnt=$(($casecnt+$iteration))
		for (( iter=0; iter<$iteration; iter=iter+1 ))
		do
		    make_option=""
		    for (( i=2; i<$line_opt_cnt; i=i+1))
		    do
		        make_option+="${line_opt[$i]} "
		    done
		    log 2 "buildUvmCase $testname $make_option"
		    buildUvmCase "${testname}_iter${iter}" "$make_option" "${test}"&
		    sleep 2
		done
	    fi
	    continue
	done < ${outputfile}

	wait

	passCnt=0
	while read line
	do
	    if [[ "$line" == *"PASS"* ]]; then
		passCnt=$(($passCnt+1))
	    fi
	done < ./result.txt
	totalTestCnt=$casecnt
	##print final general result report
	log 2 "Here is the overall result:"
	passrate=$(($passCnt*100/$totalTestCnt))
	echo "pass rate is: ${passrate}%. Please check result.txt for detail status." >> ./result.txt
	log 2 "pass rate is: ${passrate}%. Please check result.txt for detail status."
    echo "Regression finish" >>./fail_wave.txt
	exit
}

function RalGen()
{
    if [[ ! -d $dir_path/../../verify/uvm/ral ]]; then
	mkdir -p $dir_path/../../verify/uvm/ral
    fi
    csv_input=$dir_path/../../hdl/common/reg_table/reg_table_reg_list.csv
    reg_script=$dir_path/../../verify/uvm/script/gen_reg_model.py
    output=$dir_path/../../verify/uvm/ral/ral_reg_model.sv
    host=$(env | grep "^HOST=" | head -n 1 | cut -d '-' -f 3)
    echo "host is ${host}"
    python_path="/opt/anaconda3/bin/python"
    python_reg_command="$python_path $reg_script -i $csv_input  -cov addr -o $output"
    if [[ ! -f $dir_path/../../verify/uvm/ral/ral_reg_model.sv ]]; then
	log 2 "ral_reg_model.sv initial generation"
	log 2 "running command: python $reg_script -i $csv_input -cov addr -o $output"
	$python_reg_command
    else
	csv_update=`git diff $csv_input`
	script_update=`git diff $reg_script`
        if [[ -n csv_update || -n script_update ]]; then
	    log 2 "source xlsx file or script file has update, generate the ral_reg_model.sv again"
	    log 2 "running command: python $reg_script -i $csv_input  -cov addr -o $output"
	    $python_reg_command
	fi
	log 2 "if there is error happen during msim script, it might be io problem for $csv_input file, just commit your change and rerun"
    fi
    if [[ ! -f $dir_path/../../verify/uvm/ral/ral_reg_model.sv ]]; then
	log 2 "ral_reg_model.sv does not generate right, please check the source file ${csv_input}, script file ${reg_script}"
	exit -1
    fi
}


