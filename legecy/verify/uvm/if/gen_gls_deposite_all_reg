#!/opt/anaconda3/bin/python

########################################################################
##  Author: 
##  This scrypt is to generate gls_deposit_all_reg_list.sv for gls
##  Usage: 1.use vcs tool generate "getModIO.log"
##         2.finally run script "gen_gpls_reg_initial_deposit"
#########################################################################


import re
import json
import gzip
import glob


#=========parameter setting==================
file_path = 'getModIO.log'
file_path = 'getModIO_bk.log'
user_module_list=["u_crg_rst"]                      #null mean all module,only the module ,when you choose specifc module 
module_line_pat = "\s*Module: (.*) ((.*))\s*"       #could be more specific
cell_pat = "DFRPQ|SDFSYN|DFQMZ|DFSNQM"
Q_pat = "(.*)Output\s*:\s*(Q\w*)(.*)"               #could be more specific

remove_instance_repeat=True                         #remove chip instance
reg_list_file = "gls_deposit_all_reg_list_new110.sv"

#=========parameter setting==================
module_lists = []
module = []
select_pass=False
start_line =False 
end_line =False 
with open(file_path) as file_object:
    file_stdcell_lines = file_object.readlines()


for file_stdcell_line in file_stdcell_lines:
    file_stdcell_line_strip = file_stdcell_line.strip()
    module_declare_line = re.match(module_line_pat, file_stdcell_line_strip)

    if module_declare_line is not None:
        
        cell_instance = module_declare_line.group(1)
        cell_name = module_declare_line.group(2)

        # print("cell_name:",cell_name)
        # print("cell_instance:",cell_instance)   
         
        start_line = True
        end_line =False 
        module.append(cell_instance)
        module.append(cell_name[1:-2])
    elif(file_stdcell_line_strip == "" and start_line):

        start_line =False 
        end_line =True 
        module_lists.append(module)
        module = []
    elif((~end_line) and start_line and file_stdcell_line_strip.replace("-","")!=""):

        module.append(file_stdcell_line_strip)

#print("module_lists:",module_lists)   

module_lists_no_repeat=[]
if(remove_instance_repeat):
    for mod in module_lists:
        if("C[0]" in mod[0]):
            module_lists_no_repeat.append(mod)    
else:
    module_lists_no_repeat=module_lists

#print("module_lists:",module_lists_no_repeat) 


reg_lists = "`define GLS_INIT_REG_ARRARY_PER_CHIP_NEW(C_ID) \\\n"

for module_list in module_lists_no_repeat:
    select_pass=False
    if user_module_list!= []:  
        for user_ls in user_module_list:
            user_matched = re.search(user_ls, module_list[0])
            if(user_matched is not None):
                select_pass=True
                #print("found user module:",module_list[0])
                break
        
    else:
        select_pass=True

    cell_pat_matched = re.match(cell_pat, module_list[1])
    if ((cell_pat_matched is not None) and (select_pass)):
        for module in module_list[2:]:           
            q_pat_matched = re.match(Q_pat, module)              
            if q_pat_matched is not None:
                #print("q_pat_matched.group(0):",q_pat_matched.group(0))  
                #msg = module_list[0].replace('0','C_ID',1)
                msg = module_list[0].replace('[0]','[C_ID]',1)
                reg_lists += "`GLS_INIT_REG_T(C_ID," + msg + "." + q_pat_matched.group(2) +",0) \\"+ "\n"

reg_lists += "\n" 

ral_sv          = open(reg_list_file, 'w')
ral_sv.write(reg_lists)
ral_sv.close()

print("Generate gls_deposit_all_reg_list_new110.sv is done!!!")
