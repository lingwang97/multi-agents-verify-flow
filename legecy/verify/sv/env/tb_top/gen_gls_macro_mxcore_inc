egrep 'mx2_clkgen$' getModHier.log | sed 's/\(tb_top.*\)_WRAPPER_\([0-9]\+\)__/```OPT(VIF[\2],\1_WRAPPER```ChClkGenL``\2```ChClkGenR``/' | sed 's/_mx2_clkgen/_mx2_clkgen.``SRC,MSB,LSB)\\/' >> gls_macro_mxcore_inc.sv
