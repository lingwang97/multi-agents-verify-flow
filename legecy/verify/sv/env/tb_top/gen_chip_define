def calculator(expression):
    def evaluate_expression(expression):
        try:
            expression = re.sub("\d+'h", "0x", expression)
            expression = re.sub("\d+'d", "", expression)
            expression = re.sub("\d+'o", "0o", expression)
            expression = re.sub("\d+'b", "0b", expression)
            #print(expression)
			
            return eval(expression)
        except Exception as e:
            return "Calculate Error：" + str(e)

    try:
        result = evaluate_expression(expression)
        return str(result)
    except Exception as e:
        return "Calculate Error：" + str(e)

