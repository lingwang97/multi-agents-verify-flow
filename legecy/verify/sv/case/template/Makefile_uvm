
#######################################################################################################
# Step 0: Getting project name
#######################################################################################################
project = `cat ./project_name`
filelist_path=$(dataBasePath)/hdl/common/file_list
#######################################################################################################
# Step 1: Checking simulation switches from user
#######################################################################################################
#-------------------------------------------------------------------------
# Step 1.0: Checking system time
#-------------------------------------------------------------------------
#This is for msim efuse array access,add define DEBUG_ALL
DEBUG_SIM_PAR := DEBUG_ALL
debug_all_contains := $(findstring $(DEBUG_SIM_PAR), $(VCS_MACRO_OPT))

ifeq ($(debug_all_contains),)
else
	debug_all_test = 1
endif

#This is for X-state propagation check,add define XPROP_CHECK
XPROP_SIM_PAR := XPROP_CHECK
xprop_contains := $(findstring $(XPROP_SIM_PAR), $(VCS_MACRO_OPT))

ifeq ($(xprop_contains),)
else
	xprop_define =  -xprop=$(dataBasePath)/verify/sv/case/template/xprop_cfg  -report=xprop
	xprop_sim=  -report=xprop
endif

#This is for msim full(-full) test,simulation is no -fpga.
FPGA_SIM_PAR := FPGA_SYN
fpga_contains := $(findstring $(FPGA_SIM_PAR), $(VCS_MACRO_OPT))

ifeq ($(fpga),1)
	fpga_test = $(fpga)
else
ifeq ($(fpga_contains),)
else
	fpga_test = 1
endif
endif

#This is for msim full(-full) test,simulation is no -block.
BLOCK_SIM_PAR := BLOCK_TEST
block_contains := $(findstring $(BLOCK_SIM_PAR), $(VCS_MACRO_OPT))

ifeq ($(block),1)
	block_test = $(block)
else
ifeq ($(block_contains),)
else
	block_test = 1
	block_env = 1
endif
endif
# If MDL_SIM is defined, it is a module level validation environment,
# and its list_para and init_reg_cfg are different from the system level validation environment.
MDL_SIM_PAR := MDL_SIM
mdl_contains := $(findstring $(MDL_SIM_PAR), $(VCS_MACRO_OPT))

ifeq ($(mdl_contains),)
else
	mdl_test = 1
	block_env = 1
endif

MDL_EFUSE_PAR := MDL_EFUSE
mdl_contains := $(findstring $(MDL_EFUSE_PAR), $(VCS_MACRO_OPT))

ifeq ($(mdl_contains),)
else
	mdl_efuse_test = 1
	block_env = 1
endif

JAMLINK_PAR := USE_JAMLINK_DRV
UART_PAR := USE_UART_DRV
jamlink_contains :=$(findstring $(JAMLINK_PAR), $(VCS_MACRO_OPT))
uart_contains :=$(findstring $(UART_PAR), $(VCS_MACRO_OPT))
ifeq ($(block_env),)
	ifeq ($(jamlink_contains),)	
		ifeq ($(uart_contains),)
			designTag = btc_jls_$(mudue_name)$(dpo_sub_name)
		else
			designTag = btc_uart_$(mudue_name)$(dpo_sub_name)
		endif
	else
		designTag = btc_jamlink_$(mudue_name)$(dpo_sub_name)
	endif
else
	designTag = block_$(mudue_name)$(dpo_sub_name)
endif

time = 0
ifeq ($(timefix),1)
	ifeq ($(time),0)
		define_para += +define+SYSTIME='"1"'
	else
		define_para += +define+SYSTIME='"$(time)"'
	endif
else
time = $(shell date +"%Y%m%d%H%M%S")
define_para += +define+SYSTIME='"$(time)"'
endif

ifndef dataBasePath
  dataBasePath="../../.."
endif


mx2_gate_file = $(filelist_path)/mx2_gate_file_list.f
gate_file =  $(filelist_path)/gate_file_list.f
std_list_be_rek = $(filelist_path)/std_list_be_rek.f
#ip_list = $(filelist_path)/ip_list.f

UART_VIP_HOME="/project/SG/public/uart_vip/"

#-------------------------------------------------------------------------
# Step 1.2.1: Checking core netlist switch
#-------------------------------------------------------------------------
ifeq ($(core_netlist),1)
	hdl_fl_para += -f $(mx2_gate_file) -f $(filelist_path)/file_list.f
	define_para += +define+CORE_NETLIST
	fgp_compile = -fgp -j4
	fgp_para = -fgp=num_threads:20
ifeq ($(block_test),1)
	fgp_para = -fgp=num_threads:10
else
	hdl_fl_para += -f $(mx2_gate_file)
endif

endif

# run sl version default
# no more sl
#sl = 1
#-------------------------------------------------------------------------
# Step 1.2.2: Checking simulation level
#-------------------------------------------------------------------------
ifeq ($(level),gate)
	ip_list = $(filelist_path)/gls_ip_list.f
else ifeq ($(level),post)
	ip_list = $(filelist_path)/gls_ip_list.f
else
	ip_list = $(filelist_path)/ip_list.f
endif

ifeq ($(level),gate)
    hdl_fl_para += -f $(std_list_be_rek) -f $(gate_file)
	define_para += +define+PL_SIM +neg_tchk +no_notifier  +define+NTC+RECREM
	ifeq ($(block_test),1)
		hdl_fl_para += -f $(filelist_path)/mx2_block_file_list.f
	endif
	spec += -diag=sdf:verbose
else ifeq ($(level),post)
	hdl_fl_para += -f $(gate_file) -f $(std_list_be_rek)
	define_para += +define+PL_SIM +define+POST_SIM -sdfretain -negdelay +neg_tchk +optconfigfile+digit_ip_async.lst -tcheckvecsplit +define+NTC+RECREM  +define+MX2_VER

	ifneq ($(findstring NETLIST_MX2CORE,$(VCS_MACRO_OPT)),)
    	hdl_fl_para += -v /filesets/project/SG/public/btc_netlist/MAN2/20250531/netlist/slice0_coretest_part.v.gz
	    define_para += +optconfigfile+digit_slice0_async.lst
	endif
	ifneq ($(findstring SLICE0_NL_CORETEST,$(VCS_MACRO_OPT)),)
    	hdl_fl_para += -v /filesets/project/SG/public/btc_netlist/MAN2/20250531/netlist/slice0_coretest.v.gz
	    define_para += +optconfigfile+digit_slice0_async.lst
	endif
	spec += -diag=sdf:verbose
	ifeq ($(block_test),1)
		hdl_fl_para += -f $(filelist_path)/mx2_block_file_list.f
	endif
else ifeq ($(sl),1)
	hdl_fl_para +=  -f $(filelist_path)/file_list.f  -f $(filelist_path)/mx2_file_list.f -f $(filelist_path)/std_list.f
	define_para += +no_notifier +neg_tchk
else ifeq ($(fpga_test),1)
	hdl_fl_para +=  -f $(filelist_path)/file_list.f  $(dataBasePath)/hdl/common/mx2_core/mx2_core_bbox.sv -f $(filelist_path)/mx2_file_list.f $(dataBasePath)/hdl/digit_ip/tech_cell/core_tech_cell.v -f $(dataBasePath)/verify/sv/env/tb_top/fpga.f
	define_para += +no_notifier +neg_tchk
else
	hdl_fl_para +=  -f $(filelist_path)/file_list.f  -f $(filelist_path)/mx2_file_list.f  -f $(filelist_path)/std_list.f
	define_para += +no_notifier +neg_tchk    +optconfigfile+cklatch_nospecify.cfg +define+NTC+RECREM
endif

#-------------------------------------------------------------------------
# Step 1.2.2.0: Checking simulation level for common file
#-------------------------------------------------------------------------
ifneq ($(findstring $(level),gate post),)
	hdl_fl_para += -f $(filelist_path)/option_module_rtl_for_netlist_file_list.f
	hdl_fl_para += -f $(filelist_path)/mx2_file_list.f
	fgp_compile = -fgp -j 4
else
	hdl_fl_para +=
endif

#-------------------------------------------------------------------------
# Step 1.2.2.1: Checking ro test for gls or pls
#-------------------------------------------------------------------------
ifeq ($(ro),1)
	hdl_fl_para += -f $(filelist_path)/gate_ro_list.f
	fgp_compile = -fgp -j 8
	fgp_para = -fgp=num_threads:8
endif

#-------------------------------------------------------------------------
# Step 1.2.3: Checking timing-check switch
#-------------------------------------------------------------------------
ifeq ($(notimingcheck),1)
	timingcheck_para += +notimingcheck
else ifeq ($(level),prepost)
	timingcheck_para += +notimingcheck
else
	timingcheck_para +=
endif

#-------------------------------------------------------------------------
# Step 1.2.4: UVM VERBOSITY
#-------------------------------------------------------------------------
ifeq ($(uvm_verbosity),0)
	UVM_VERBOSITY = UVM_NONE
else ifeq ($(uvm_verbosity),1)
	UVM_VERBOSITY = UVM_LOW
else ifeq ($(uvm_verbosity),2)
	UVM_VERBOSITY = UVM_MEDIUM
else ifeq ($(uvm_verbosity),3)
	UVM_VERBOSITY = UVM_HIGH
else ifeq ($(uvm_verbosity),4)
	UVM_VERBOSITY = UVM_FULL
else
	UVM_VERBOSITY = UVM_MEDIUM
endif

#-------------------------------------------------------------------------
# Step 1.3: Checking simulation corner when level=post
#-------------------------------------------------------------------------
ifeq ($(corner),wst)
	define_para += +define+CORNER_MIN
else ifeq ($(corner),bst)
	define_para += +define+CORNER_MAX
else ifeq ($(corner),typ)
	define_para += +define+CORNER_TYP
else ifeq ($(corner),setup_ssg)
	define_para += +define+CORNER_SETUP_SSG
else ifeq ($(corner),hold_tt)
	define_para += +define+CORNER_HOLD_TT
else ifeq ($(corner),hold_ffg)
	define_para += +define+CORNER_HOLD_FFG
else
	define_para += +define+CORNER_TYP
endif

#-------------------------------------------------------------------------
# Step 1.4: Checking mtm type when level=post
#-------------------------------------------------------------------------
ifeq ($(mtm),min)
	define_para += +define+MTM_SPEC='"MINIMUM"'
else ifeq ($(mtm),max)
	define_para += +define+MTM_SPEC='"MAXIMUM"'
else ifeq ($(mtm),typ)
	define_para += +define+MTM_SPEC='"TYPICAL"'
else
	define_para += +define+MTM_SPEC='"TOOL_CONTROL"'
endif


#-------------------------------------------------------------------------
# Step 1.5: Checking specify switch
#-------------------------------------------------------------------------
ifeq ($(specify),1)
	spec +=
else
	spec +=
	#spec += +nospecify
endif

#-------------------------------------------------------------------------
# Step 1.6: Checking coverage switch
#-------------------------------------------------------------------------
ifeq ($(cm),1)
	ifneq ($(findstring $(level),gate post),)
		cm_para =
	else
		cm_para = -cm line+cond+fsm+tgl+branch +define+FUNC_COV -cm_line contassign -cm_test $(testname) -cm_hier Makefile.coverage.cfg
	endif
else
	cm_para =
endif

#-------------------------------------------------------------------------
# Step 1.7: Checking rtdbg switch
#-------------------------------------------------------------------------
ifeq ($(rtdbg),1)
	dump_vcs  += -rtdbg
	dump_simv += -rtdbg=dump -do Makefile.rtdbg.tcl
else
	dump_vcs  +=
	dump_simv += -do Makefile.run.tcl
endif

#-------------------------------------------------------------------------
# Step 1.8: Checking waveform dumping switch
#-------------------------------------------------------------------------
ifeq ($(fsdb),1)
	dump_vcs += +define+DUMP_FSDB
	fsdb_force = +fsdb+force
	ifeq ($(lib),1)
		dump_vcs += -debug_access+all -debug_region=cell+lib
	else
		dump_vcs += -debug_access+all -debug_region=cell+lib
	endif
else
	fsdb_force =
	ifneq ($(findstring $(level),gate post),)
		dump_vcs += -debug_access+all -debug_region=cell+lib
	else
	ifeq ($(debug_all_test),1)
		dump_vcs += -debug_access+all -debug_region=cell+lib
	else
		dump_vcs += -debug_access+r+f+fwn+w
	endif
	endif
endif


ifeq ($(vpd),1)
	dump_vcs += -debug_access+dmptf +define+DUMP_VPD
	ifeq ($(lib),1)
		dump_vcs += -debug_access+all -debug_region=cell+lib
	else
		dump_vcs += -debug_access+dmptf
	endif
else
	dump_vcs +=
endif

#add DUMP_CP_WAVEFORM is to enable cpft dump feature
ifeq ($(cpdump),0)
	dump_vcs +=
else
	dump_vcs += +define+DUMP_CP_WAVEFORM
endif

#-------------------------------------------------------------------------
# Step 1.9: Checking loop detect/report switch
#-------------------------------------------------------------------------
ifeq ($(loop),1)
	loop_opt += +vcs+loopreport+10000000
else
	loop_opt +=
endif

#-------------------------------------------------------------------------
# Step 1.10: Checking simprofile switch
#-------------------------------------------------------------------------
ifeq ($(profile),time)
	simprofile_opt = -simprofile time
else ifeq ($(profile),mem)
	simprofile_opt = -simprofile mem
else ifeq ($(profile),timemem)
	simprofile_opt = -simprofile time+mem
endif

#-------------------------------------------------------------------------
# Step 1.11: Checking rtl coding error
#-------------------------------------------------------------------------
ifeq ($(ongs),1)
	compile_option += -error=ONGS
else
	compile_option += +error+10000
endif

#-------------------------------------------------------------------------
# Step 1.12: Checking gui switch
#-------------------------------------------------------------------------
ifeq ($(guiswitch),1)
    gui_option += -gui=verdi
else
    gui_option +=
endif


#######################################################################################################
# Step 2: Merging define_para and filelist_para
#######################################################################################################

ifndef UVM_TESTNAME
## original sv cases
        loc_define = \
	./sim_define.v \
	./custom_sim_define.v
	tb_top_define = \
	-f $(dataBasePath)/verify/sv/env/tb_top/tb_top.f
	sim_define_option = `cat sim_define.option`
else
## uvm env cases, all define files shall be defined in test.lst and put in the make command
	ifeq ($(block_test),1)
		tb_top_define = -f $(dataBasePath)/verify/uvm/script/uvm_mx2.f
		vcs_para += +v2k -full64 -sverilog +lint=PCWM +lint=TFIPC-L +overlap -kdb -lca -debug_access+all 
		fgp_compile =
		fgp_para =
	else ifeq ($(case_block),uart_vip)
		tb_top_define = -f $(dataBasePath)/verify/uvm/script/uvm_vip.f
	else ifeq ($(mdl_efuse_test),1)
		tb_top_define = -f $(dataBasePath)/verify/uvm/script/uvm_efuse.f
	else
		tb_top_define = -f $(dataBasePath)/verify/uvm/script/uvm.f
	endif
		uvm_package = -ntb_opts uvm-1.2
		uvm_para = +UVM_TESTNAME=$(UVM_TESTNAME) +UVM_VERBOSITY=$(UVM_VERBOSITY)
endif

ifeq ($(dpo),learn)
	vcs_para += -dpo  -dpo_opts mode=learn+dbdir=$(dataBasePath)/sim/dpo_learn_db  -dpo_opts design_tag=$(designTag)+user_tag=learn+apps=default,lint,upfopt,pgates,gates_ml
	dpo_sim_para = -dpo -dpo_opts test_name=$(testname)
else ifeq ($(dpo),apply_reco)
	vcs_para += -dpo  -dpo_opts mode=apply+learn_dbdir=$(dataBasePath)/sim/dpo_learn_db+dbdir=$(dataBasePath)/sim/dpo_apply_db  -dpo_opts design_tag=$(designTag)+user_tag=apply+apps=default,fgp,lint,upfopt,pgates,gates_ml -dpo_opts reco_file=$(dataBasePath)/sim/dpo_reco.csv
	dpo_sim_para = -dpo -dpo_opts test_name=$(testname)
else ifeq ($(dpo),apply)
	vcs_para += -dpo  -dpo_opts mode=apply+learn_dbdir=$(dataBasePath)/sim/dpo_learn_db+dbdir=$(dataBasePath)/sim/dpo_apply_db  -dpo_opts design_tag=$(designTag)+user_tag=apply+apps=default,fgp,lint,upfopt,pgates,gates_ml
	dpo_sim_para = -dpo -dpo_opts test_name=$(testname)
else ifeq ($(dpo),refer)
	vcs_para += -dpo  -dpo_opts apps=vcsgd+dbdir=$(dataBasePath)/sim/dpo_refer_db+design_tag=$(designTag)+user_tag=reference
	dpo_sim_para = -dpo -dpo_opts test_name=$(testname)
else
	vcs_para +=
	dpo_sim_para = 
endif


ifeq ($(fpga_test),1)
	fpga_define = \
	-f $(dataBasePath)/verify/sv/env/tb_top/fpga.f  -top glbl
endif

ifneq ($(upf_file),)
	define_para += +define+UPF -upf $(upf_file)
endif

ifeq ($(48m),1)
	define_para += +define+OSC_48M
endif


ifeq ($(mdl_test),)
list_para = \
	$(dataBasePath)/verify/sv/env/tb_top/btc_project_define.sv \
	$(loc_define) \
	-f $(filelist_path)/define.f \
	$(dataBasePath)/verify/sv/env/tb_top/tb_define.sv \
	$(hdl_fl_para) \
	-f $(dataBasePath)/verify/sv/env/tb_top/include.f \
	-f $(ip_list) \
	$(tb_top_define) \
	-f $(dataBasePath)/verify/sv/component/jlm/jlm_file.f \
	$(fpga_define) \
	$(xprop_define) \
	$(dataBasePath)/verify/uvm/utils/dpi_func.c
   ifeq ($(block_contains),)
   	init_reg_cfg = +vcs+initreg+config+Makefile.initreg.cfg 
   else
   	init_reg_cfg = +vcs+initreg+config+mx2.reg_config
   endif
   ifeq ($(mdl_efuse_test),1)
	init_reg_cfg = +vcs+initreg+random 
   endif
else
	#Extract the name of the module and remove any spaces.
	first_char = $(word 1,$(subst _, ,$(1)))
	MDL_PATH:= $(shell echo $(call first_char,$(UVM_TESTNAME)) | sed 's/ //g')
	list_para = -f $(dataBasePath)/verify/uvm/uvc/$(MDL_PATH)/script/uvm_mdl.f
	compile_option += +vcs+initreg+random
#init_reg_cfg =
endif
#SEED = 1
ifdef seed
	SEED=$(seed)
else
	SEED := $(shell python2 -c "from random import randint; print randint(0,99999999)")
endif

ifndef VCS_MARCO_OPT
   VCS_MACRO_OPT = ""
endif

ifdef VCS_PLUSARGS_OPT
   uvm_para +=$(subst +, +,$(VCS_PLUSARGS_OPT))
endif

# 1core->2cores->4cores compile time: 207->179->153s
compile_option += -pcmakeprof -j2




#######################################################################################################
# Step 3: Objects
#######################################################################################################
default:cmp
echo_hostname:
	echo $$HOSTNAME > ./hostname
cmp:
	make com_echo; make simv_echo; make echo_hostname cmpr; vlogan -ntb_opts uvm-1.2; make covsim; echo current time is $(time); echo current SEED is $(SEED)
cmpr:
	vcs $(VCS_MACRO_OPT) -timescale=1ns/10ps  +v2k -sverilog $(fgp_compile) -full64 -l compile.log -licqueue -kdb -lca +error+100 \
	+sdfverbose \
	+lint=PCWM \
	+lint=TFIPC-L \
	+lint=PCWM \
	-P ${VERDI_HOME}/share/PLI/VCS/linux64/novas.tab  ${VERDI_HOME}/share/PLI/VCS/linux64/pli.a \
	$(init_reg_cfg) \
    $(uvm_package) \
	$(spec) \
	$(loop_opt) \
	$(dump_vcs) \
	$(compile_option) \
	$(cm_para) \
	$(vcs_para) \
	$(define_para) \
	$(timingcheck_para) \
	$(simprofile_opt) \
	$(sim_define_option) \
	$(list_para) \
	$(vip_comp_para) \
	-top tb_top
	##-P ${VERDI_HOME}/share/PLI/VCS/linux64/novas.tab  ${VERDI_HOME}/share/PLI/VCS/linux64/pli.a

sim:
	./simv +vcs+lic+wait -ucli -l sim.log +ntb_random_seed=$(SEED) $(simv_opt) -do Makefile.run.tcl;
covsim:
	./simv +vcs+lic+wait -ucli -l sim.log +ntb_stop_on_constraint_solver_error=1 -assert quiet+report +UVM_VERDI_TRACE=COMPWAVE+HIER+RALWAVE +fsdbfile+novas.fsdb $(fsdb_force) $(uvm_para)  $(pll_custom_cfg) $(gui_option) +ntb_random_seed=$(SEED) $(dump_simv) $(cm_para) $(fgp_para) $(simv_opt) $(vip_sim_para)$(xprop_sim) $(init_reg_cfg) $(dpo_sim_para)
show:
	dve -vpd simv.vpd -full64 &
covshow:
	dve -full64 -covdir simv.vdb&
clean:
	rm -rf *.fsdb *.log simv.vdb simv.vpd DVEfiles waveform.vpd csrc  gvlist simv  simv.daidir    ucli.key  vcdplus.vpd  vcs.log pulltime sdfAnnotateInfo 64 verdiLog novas.conf novas.rc

verdi:
	make echo_def;
	sim_define_option=`cat def.v`; \
	verdi 	\
	-2001 \
	-2012 \
	-extinclude \
	-ssv \
	-ssy \
	-ssz \
	-sv \
	+systemverilogext+.sv+.SV+.svh+.v+.V+ \
	-top tb_top \
	-ssf ./novas.fsdb \
	$(define_para) \
	$$sim_define_option \
	$(list_para) &

echo_def:
	./gen_define.bash

result:
	verdi 	\
	-ssv \
	-ssy \
	-dbdir ./simv.daidir \
	-ssf ./novas.fsdb \
	-smlog ./sim.log


#######################################################################################################
# Step 4: Store vcs cmd
#######################################################################################################
#com_var:
com_var = vcs $(VCS_MACRO_OPT) -timescale=1ns/10ps  +v2k -sverilog $(fgp_compile) -full64 -l compile.log -licqueue -kdb -lca +error+100 \
	+vcs+initreg+config+Makefile.initreg.cfg \
	+sdfverbose \
	+lint=PCWM \
	+lint=TFIPC-L \
	+lint=PCWM \
	-P ${VERDI_HOME}/share/PLI/VCS/linux64/novas.tab  ${VERDI_HOME}/share/PLI/VCS/linux64/pli.a \
        $(uvm_package) \
	$(spec) \
	$(loop_opt) \
	$(dump_vcs) \
	$(compile_option) \
	$(cm_para) \
	$(vcs_para) \
	$(define_para) \
	$(timingcheck_para) \
	$(simprofile_opt) \
	$(sim_define_option) \
	$(list_para) \
	$(vip_comp_para) \
	-top tb_top

simv_var = ./simv +vcs+lic+wait -ucli -l sim.log +UVM_VERDI_TRACE=COMPWAVE+HIER+RALWAVE  $(fsdb_force) $(uvm_para)  $(pll_custom_cfg) $(gui_option) +ntb_random_seed=$(SEED) $(dump_simv) $(cm_para) $(fgp_para) $(simv_opt) $(vip_sim_para)

com_echo:
	echo -e "#!/bin/bash\n\n"  $(com_var) > ./com_cmd; chmod +x ./com_cmd
simv_echo:
	echo -e "#!/bin/bash\n\n"  $(simv_var) > ./simv_cmd; chmod +x ./simv_cmd

run_com:
	./com_cmd | tee compile.log

run_simv:
	./simv_cmd | tee sim.log

run_case:
	make run_com; make run_simv