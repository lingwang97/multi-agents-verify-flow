    else
        comp_dir="comp_"$testname
        make_option+=" cm_name=$folder"
        make_option+=" cm_dir=../$comp_dir/simv.vdb"

        wait_file_timeout "$comp_dir/simv" "7200" "10" "$comp_dir/cstatus.log"   #Could be optimize
        if [[ -n $OPTS_MODULE || -n $OPTS_REGRESSION_MODE ]]; then
            if [[ $make_define = *"REAL_CORE"* ]]; then
                scene="REALCORE_"
            else
                scene="FAKECORE_"
            fi
        fi
        scene=${scene}"sim_${folder}_${OPTS_LEVEL}"
        rm -rf $scene
        mkdir $scene -p
        cd $scene
        cp $makefile_name ./Makefile
        cp $tclfile_name  ./
        cp $rtdbgfile_name ./
        cp $initregfile_name ./Makefile.initreg.cfg
        cp $coverfile_name ./Makefile.coverage.cfg
        ln -s ../$comp_dir/simv ./simv
        ln -s ../$comp_dir/csrc ./csrc
        ln -s ../$comp_dir/simv.daidir ./simv.daidir
        ln -s ../$comp_dir/ucli.key ./ucli.key

    fi
    
    host=$(env | grep "^HOST=" | head -n 1 | cut -d '-' -f 3)
    echo ----------------------LSF_INFO-------------------------
    echo -e "\tThe host is : ${host}"
    if [[ $host != *"cch"* && $host != *"gat0"* ]]; then
	    OPTS_LSF="FALSE"
        echo -e "OPTS_LSF is $OPTS_LSF due to host is not gs02"
    fi



    if [[ -n $OPTS_HOST ]]; then
        bsub_option="bsub -n ${OPTS_LSF_CORES} -m ${OPTS_HOST} -I ${OPTS_LSF_SIG} -q ${OPTS_LSF_QUEUE}"
    elif [[ $OPTS_LSF == "TRUE" ]]; then
        ## This part need to be maintained
        host_file="$WSIM_LSF_HOSTS_FILE"
        lines=$(grep "$WSIM_LSF_QUEUE" ${host_file})
        queue_names=($(grep "$WSIM_LSF_QUEUE" ${host_file} | head -3 | cut -d ' ' -f 1))
        lsf_queue_name=($(grep "$WSIM_LSF_QUEUE" ${host_file} | head -3 | cut -d ' ' -f 1 | sed 's/amd/a/g'))
        queue_number=${#queue_names[@]}
        lsf_host_name=(0 0 0)
        lsf_host_slot=(0 0 0)
        #declare -A lsf_host_name
        for((i=0;i<queue_number;i+=1));do
            queue=${queue_names[i]}
            echo -e "\tThe queue is : ${queue}"
            temp=$(grep $queue ${host_file} | grep -Eo "kulh1-a[0-9a-zA-Z]+-cch[0-9]+")
            temp1=($temp)
            tmp_line=""
            for tmp in "${temp1[@]}";do
                tmp_line+=$tmp" "
            done
            lsf_host_name[i]=$tmp_line
            #echo -e "\tThe lsf_host is : \n\t\t\t${lsf_host_name[i]}"
        done

        t1=$(bhosts -o "HOST_NAME")
        hosts=($t1)
        t2=$(bhosts -o "status")
        host_status=($t2)
        t3=$(bhosts -o "MAX")
        host_max=($t3)
        t4=$(bhosts -o "NJOBS")
        host_njobs=($t4)

        for((i=0;i<queue_number;i+=1));do
            tmp=${lsf_host_name[i]}
            queue=($tmp)
            #echo queue $queue
            for host in "${queue[@]}";do
            #echo host $host
            index=0
            for reg in "${hosts[@]}"; do
                #echo reg $reg
                if [[ "${host}" == *"${reg}"* ]];then
                #echo $index
                break
                fi
                index=$(($index+1))
            done
            if [[ ${host_status[index]} == "ok" ]]; then
                lsf_host_slot[i]=$((${lsf_host_slot[i]}+${host_max[index]}-${host_njobs[index]}))
            fi
            done
        done

        for((i=0;i<queue_number;i+=1));do
            echo -e "\tThe ${lsf_queue_name[i]} has ${lsf_host_slot[i]} remaining"
            echo -------------------------------------------------------
        done

        max=0
        max_index=0
        for((i=0;i<queue_number;i++));do
            if [[ $max -lt ${lsf_host_slot[i]} ]];then
                max=${lsf_host_slot[i]}
                max_index=$i
            fi
        done

        OPTS_LSF_QUEUE=${lsf_queue_name[max_index]}

        if [[ $OPTS_QUEUE == "TRUE" ]] ; then
            bsub_option="bsub -n $OPTS_LSF_CORES -I -R \"order[ut]\" -q  ${OPTS_SET_QUEUE} ${OPTS_LSFSIG} "
        else
            bsub_option="bsub -n $OPTS_LSF_CORES -I -R \"order[ut]\" -q  ${OPTS_LSF_QUEUE} ${OPTS_LSFSIG} "
        fi

	    bsub_option+="-J \"run_in$(pwd)\" "
    fi # end of elif [[ $OPTS_LSF == "TRUE" ]]; then


    if [ $simrun == "FALSE" ]; then
        make_para="make $make_define $make_option"
        log 2 "running compile command: ${bsub_option} ${timeout_option} ${make_para} at `pwd`"
        ${bsub_option} ${timeout_option} ${make_para}
        if [[ -f compile.log ]]; then
            touch cstatus.log
            if grep -q "^Error-\[.*\]" compile.log; then
                #echo "COMPILE FAILED" | tee -a compile.log
                echo "FAIL" > cstatus.log
                echo "$testname			compile_error" >> ${sim_dir}/result.txt
                cd $wsim_dir_path
                exit 1
            elif grep -q "SDF Error:" compile.log; then
                #echo "SDF FAILED" | tee -a compile.log
                echo "SDF_ERROR" > cstatus.log
                echo "$testname			compile_error" >> ${sim_dir}/result.txt
                cd $wsim_dir_path
                exit 1
            else
                #echo "COMPILE SUCCESSED" | tee -a compile.log
                echo "PASS" > cstatus.log
            fi
        fi

    else
        make_para="make sim $make_define $make_option"
        log 2 "running sim command: ${bsub_option} ${timeout_option} ${make_para} at `pwd`"
        ${bsub_option} ${timeout_option} ${make_para}

        if [[ -f sim.log ]]; then
            status=$?
            if [[ $status -eq 0 ]]; then
                echo "simulation status exit code: $status" | tee -a sim.log
            fi
            if [[ $OPTS_TRY_ALL_HOST -ge 0 ]]; then
                    if [[ $(grep "FGP_AFFINITY_FAILED" sim.log) ]]; then
						rm subloop.log -f
						echo "FGP_AFFINITY_FAILED found, OPTS_TRY_ALL_HOST is $OPTS_TRY_ALL_HOST" | tee -a subloop.log
						#queue_number=4
						echo ${bsub_option} ${timeout_option} ${make_para} > sim_rerun
						chmod +x sim_rerun
						#sed -i 's/bsub.*make/bsub -n 40 -m $1 -I -q $2 -J $3 make covsim/' sim_rerun
						closed_host=$(bhosts | grep "closed")
						submited=0
						#while [ 1 ]
						for((idx=1;idx<=$OPTS_TRY_ALL_HOST;idx+=1));do
							echo "+++++++++++++ try all $queue_number queue and host, $idx loop" | tee -a subloop.log
							for((q=0;q<queue_number;q+=1));do
								qn=${lsf_queue_name[q]}
								tmp=${lsf_host_name[q]}
								queue=($tmp)
								for host in "${queue[@]}";do
									host=${host//\"}
									myjobid=$(date +%N)
									echo "+++++++++++++ try host: $qn ${host}" | tee -a subloop.log
									if [[ $closed_host =~ $host ]]; then
										echo "+++++++++++++       $qn ${host} closed,skip it." | tee -a subloop.log
										echo "step_0: $qn $host closed, Skip it." | tee -a subloop.log
										continue
									fi
									sim_rerun ${host} $qn JID_$myjobid"_"$(pwd) &
									usleep 10000000 # wait 10s
									jobid=$(bjobs -w | grep JID_$myjobid | head -c 8 )
									echo "step_1: $jobid, Begin__$qn $host " | tee -a subloop.log
									pcnt=0
									while [ 1 ]
									do
										usleep 30000000 # wait 30s
										pcnt=$(($pcnt+1))
										flag=$(bjobs -w | grep JID_$myjobid | grep RUN )
										pflag=$(bjobs -w | grep JID_$myjobid | grep PEND)
										if [[ $flag ]]; then
											echo "step_2: $jobid,   Submit Done!" | tee -a subloop.log
											submited=1
											break
										fi
										if [[ $pflag ]]; then
											echo "step_3: $jobid,   Waitting PEND $pcnt times." | tee -a subloop.log
											if [[ $pcnt -eq 2 ]]; then
												echo "step_4: $jobid,   Waitting PEND timeout, killed." | tee -a subloop.log
												bkill $jobid
												break
											fi
										else
											echo "step_5: $jobid,   Submit Fail!" | tee -a subloop.log
											break
										fi
									done
									echo "step_6: $jobid, End____$qn $host" | tee -a subloop.log
									if [[ $submited -eq 1 ]]; then
										echo "step_7: Job submitted, Skip other host" | tee -a subloop.log
										break
									fi
								done
								if [[ $submited -eq 1 ]]; then
									echo "step_7: Job submitted, Skip other queue" | tee -a subloop.log
									break
								fi
							done
							if [[ $submited -eq 1 ]]; then
								break
							else
								echo "step_8: Had try all queue and host" | tee -a subloop.log
							fi
						done # end of idx
                    fi
            fi # end of OPTS_TRY_ALL_HOST
        fi

        
        if [[ -f cm.log ]]; then
            rm cm.log
        fi
