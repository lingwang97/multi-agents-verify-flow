function RalGen()
{
    # register table location is project-level: WSIM_REG_TABLE (verify/script/sflow/flow_env.sh)
    csv_input=$WSIM_REG_TABLE
    reg_script=$database_path/verify/utils/reg/gen_reg_model.py
    output=$database_path/verify/ral/ral_reg_model.sv
    if [[ ! -f $csv_input ]]; then
        # No CSV is a valid state while enable_ral is off: skip instead of aborting the
        # whole run. A case whose filelist compiles ral_reg_model.sv then fails at
        # compile time with the model missing; this log line says why.
        log 2 "register table not found: $csv_input - RalGen skipped. Cases compiling the RAL model (enable_ral) need it: provide the CSV or update WSIM_REG_TABLE in verify/script/sflow/flow_env.sh"
        return 0
    fi
    if [[ ! -d $database_path/verify/ral ]]; then
        mkdir -p $database_path/verify/ral
    fi
    host=$(env | grep "^HOST=" | head -n 1 | cut -d '-' -f 3)
    echo "#############################"
    echo "####  host is ${host}  ######"
    echo "#############################"
    python_path="$WSIM_PYTHON"
    python_reg_command="$python_path $reg_script -i $csv_input -cov addr -o $output"
    # regenerate when the model is missing or older than the CSV / generator
    # (mtime works for any CSV location, unlike the former git-diff check)
    if [[ ! -f $output || $csv_input -nt $output || $reg_script -nt $output ]]; then
        log 2 "generating ral_reg_model.sv from $csv_input"
        log 2 "running command: $python_reg_command"
        $python_reg_command
    fi
    if [[ ! -f $output ]]; then
        log 2 "ral_reg_model.sv does not generate right, please check the source file ${csv_input}, script file ${reg_script}"
        exit -1
    fi
}


