function log()
{
    log_verbosity=$1
    message=$2
    logPreFix="****$me****:"
    #verbosity level:
    #verbosity==1: Error message
    #verbosity==2: debug message
    #verbosity==3: info message
    if [[ $log_verbosity -eq 1 ]]; then
	echo "$logPreFix'ERROR!!!'$message" | tee -a $simlog_dir
    elif [[ $log_verbosity -eq 2 ]]; then
	echo "$logPreFix'(DEBUG)'$message" | tee -a $simlog_dir
    elif [[ $log_verbosity -eq 3 ]]; then
	echo "$logPreFix'(INFO)'$message" | tee -a $simlog_dir
    fi
}


