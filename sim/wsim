wait_file_timeout() {
    local tfile="$1"
    local timeout="$2"
    local interval="$3"
    local cstatus_file="$4"
    local elapsed=0
    if [ -f $cstatus_file ];then
        comp_status=$(cat $cstatus_file)
    fi
    while [ ! -f "$tfile" ] || [[ $comp_status != "PASS" ]]; do

        # echo "cstatus_file: $cstatus_file"
        # echo "comp_status: $comp_status"
 
        if [[ $comp_status == "FAIL" ]]; then
            echo "COMPILE FAIL,Simulatin Failed!!!"
            exit 1
        elif [[ $comp_status == "SDF_ERROR" ]]; then
            echo "SDF ERROR,Simulatin Failed!!!"
            exit 1
        # else
        #     echo "waiting vcs compile ..."
        fi

        sleep $interval
        elapsed=$((elapsed + interval))        
        if [ $elapsed -ge "$timeout" ]; then
            echo "wait compile to simv timeout!!"
            exit 1
        fi
        if [ -f $cstatus_file ];then
        	comp_status=$(cat $cstatus_file)
    	fi
    done
    echo "generated $tfile file done,continus to run simv"
}

